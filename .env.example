# GastKlar Rhein-Neckar — nur Variablennamen, niemals echte Werte committen.
# Kopieren nach .env.local und lokal befüllen.

# Öffentliche Basis-URL (canonical, hreflang, Sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=
# Optional: öffentliche Kontaktadresse (Ersatzweg bei Formularfehler); leer = nicht angezeigt
NEXT_PUBLIC_CONTACT_EMAIL=

# Lead-Formular
LEAD_MAIL_TRANSPORT=outbox        # outbox | smtp | fail (nur Test)
CONTACT_RECIPIENT_EMAIL=          # internes Postfach für Anfragen
LEAD_SEND_CONFIRMATION=false      # true = Eingangsbestätigung an Kunden
LEAD_RATE_LIMIT_MAX=5             # Anfragen pro IP in 10 Minuten

# SMTP (nur bei LEAD_MAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
LEAD_MAIL_FROM=

# Später (Phase D–F), aktuell ungenutzt — nur aktivieren, wenn benötigt
EMAIL_PROVIDER_API_KEY=
DATABASE_URL=
GOOGLE_GEMINI_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_IG_ACCOUNT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
CRON_SECRET=
ADMIN_AUTH_SECRET=

# Feature Flags (Standard: aus)
FEATURE_CONTENT_PIPELINE=false
FEATURE_AUTO_PUBLISH=false
FEATURE_PROSPECTING=false
